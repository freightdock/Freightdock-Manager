[Unit]
Description=Freightdock manager-agent (cluster control plane)
After=network-online.target
Wants=network-online.target

[Service]
# Settings in /etc/freightdock/manager.env, e.g.
#   FREIGHTDOCK_MANAGER_ADVERTISE=192.0.2.11:7450
EnvironmentFile=-/etc/freightdock/manager.env
Environment=FREIGHTDOCK_MANAGER_DATA=/var/lib/freightdock-manager
# An upgrade from the managers stages the new binary in the data folder (ProtectSystem keeps the manager from
# writing here); "+" runs this as root, past the sandbox, to put it in place before the manager starts.
ExecStartPre=+/usr/local/bin/freightdock-manager upgrade-apply
ExecStart=/usr/local/bin/freightdock-manager serve
Restart=always
RestartSec=2
StateDirectory=freightdock-manager
StateDirectoryMode=0700
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
